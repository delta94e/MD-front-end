{
  "compilerOptions": {
    /* ── Language & Target ───────────────────────────────── */
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],

    /* ── JSX ─────────────────────────────────────────────── */
    "jsx": "react-jsx",

    /* ── Type Safety ─────────────────────────────────────── */
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,

    /* ── Module Resolution ───────────────────────────────── */
    "baseUrl": ".",
    /* "bundler" is the correct setting for webpack/vite projects (TS 5.0+).
       It honours package.json "exports" + "typesVersions" maps,
       allowing subpath imports like "@mfe-demo/shared-ui/store".
       @mfe-demo/shared-ui is symlinked in node_modules via `npm install`. */

    /* ── Emit ────────────────────────────────────────────── */
    "noEmit": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    /* ── Skip lib checks for MF remote stubs & 3rd-party ── */
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
