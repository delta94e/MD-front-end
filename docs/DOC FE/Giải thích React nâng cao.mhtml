 c=C3=B3 m=E1=BB=99t =E1=BB=A9ng d=E1=BB=A5ng ch=E1=BB=89nh s=E1=BB=ADa =E1=
=BA=A3nh, trong =C4=91=C3=B3 ng=C6=B0=E1=BB=9Di d=C3=B9ng c=C3=B3 th=E1=BB=
=83 thay =C4=91=E1=BB=95i =C4=91=E1=BB=99 s=C3=A1ng c=E1=BB=A7a =E1=BA=A3nh=
 b=E1=BA=B1ng slider. M=E1=BB=97i l=E1=BA=A7n ng=C6=B0=E1=BB=9Di d=C3=B9ng =
