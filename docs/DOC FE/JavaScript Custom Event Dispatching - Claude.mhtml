<p class=3D"whitespace-normal break-words">// Helper methods
getElementDescription(element) {
if (element =3D=3D=3D document) return 'document';
if (element =3D=3D=3D window) return 'window';
if (element.tagName) {
const id =3D element.id ? <code class=3D"bg-text-200/5 border border-0.5 bo=
rder-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 p=
y-px text-[0.9rem]">#${element.id}</code> : '';
const classes =3D element.className ? <code class=3D"bg-text-200/5 border b=
order-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.=
4rem] px-1 py-px text-[0.9rem]">.${element.className.split(' ').join('.')}<=
/code> : '';
return <code class=3D"bg-text-200/5 border border-0.5 border-border-300 tex=
t-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]"=
>${element.tagName.toLowerCase()}${id}${classes}</code>;
}
return element.constructor.name;
}</p>
