</span><span>  static scenario3_NABSecurity() {
</span><span>    return {
</span><span>      context: `
</span><span>        NAB banking app c=E1=BA=A7n associate sensitive financ=
ial data v=E1=BB=9Bi user sessions.
</span><span>        Data includes account balances, transaction history, p=
ersonal information.
</span><span>        Compliance requires automatic data cleanup v=C3=A0 aud=
it trails.
</span><span>      `,
</span><span>     =20
</span><span>      question: `
</span><span>        Implement secure data association system v=E1=BB=9Bi:
</span><span>        1. Automatic cleanup khi sessions expire
</span><span>        2. Audit trail cho data access
</span><span>        3. Compliance v=E1=BB=9Bi GDPR/PCI DSS
</span><span>        4. No sensitive data persistence beyond session
</span><span>      `,
</span><span>     =20
</span><span>      expectedThinking: `
</span><span>        Security considerations:
</span><span>        - Data lifecycle tied to session lifecycle
</span><span>        - Automatic cleanup critical for compliance
</span><span>        - Audit requirements for access tracking
</span><span>        - Memory security (no data leaks)
</span><span>        - Regulatory compliance automation
</span><span>      `,
</span><span>     =20
</span><span>      strongAnswer: `
</span><span>        Security-focused WeakMap design:
</span><span>       =20
</span><span>        \`\`\`javascript
</span><span>        class SecureDataManager {
</span><span>          constructor() {
</span><span>            // Encrypted data storage
</span><span>            this.encryptedData =3D new WeakMap();
</span><span>            this.auditTrails =3D new WeakMap();
</span><span>            this.accessTokens =3D new WeakMap();
</span><span>           =20
</span><span>            // Compliance tracking
</span><span>            this.dataClassification =3D new WeakMap();
</span><span>          }
</span><span>         =20
</span><span>          associateData(sessionObj, sensitiveData) {
</span><span>            // Encrypt before storage
</span><span>            const encrypted =3D this.encrypt(sensitiveData);
</span><span>            this.encryptedData.set(sessionObj, encrypted);
</span><span>           =20
</span><span>            // Create audit trail
</span><span>            this.auditTrails.set(sessionObj, {
</span><span>              dataAccessed: [],
</span><span>              accessAttempts: [],
</span><span>              complianceChecks: []
</span><span>            });
</span><span>           =20
</span><span>            // Classify data for compliance
</span><span>            this.dataClassification.set(sessionObj, {
</span><span>              containsPII: true,
</span><span>              retentionPolicy: 'session-only',
</span><span>              complianceLevel: 'PCI-DSS'
</span><span>            });
</span><span>          }
</span><span>         =20
</span><span>          accessData(sessionObj, dataType, purpose) {
</span><span>            // Security validation
</span><span>            if (!this.validateAccess(sessionObj, dataType)) {
</span><span>              this.logSecurityViolation(sessionObj, dataType);
</span><span>              throw new SecurityError('Access denied');
</span><span>            }
</span><span>           =20
</span><span>            // Log access for audit
</span><span>            const audit =3D this.auditTrails.get(sessionObj);
</span><span>            audit.dataAccessed.push({
</span><span>              dataType,
</span><span>              purpose,
</span><span>              timestamp: Date.now(),
</span><span>              complianceNote: 'Legitimate business access'
</span><span>            });
</span><span>           =20
</span><span>            // Decrypt and return
</span><span>            const encrypted =3D this.encryptedData.get(session=
Obj);
</span><span>            return this.decrypt(encrypted[dataType]);
</span><span>          }
</span><span>         =20
</span><span>          // Session termination triggers automatic cleanup
</span><span>          terminateSession(sessionObj) {
