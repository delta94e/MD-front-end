<p class=3D"whitespace-pre-wrap break-words">getIndexedDBVersion() {
// Detect IndexedDB version by feature availability
if (typeof IDBKeyRange !=3D=3D 'undefined' &amp;&amp; 'includes' in IDBKeyR=
ange) {
return '3.0'; // Latest features
} else if (typeof IDBTransaction !=3D=3D 'undefined' &amp;&amp; 'objectStor=
eNames' in IDBTransaction.prototype) {
return '2.0';
} else {
return '1.0';
}
}</p>
