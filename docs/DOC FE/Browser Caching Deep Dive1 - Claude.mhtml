<span>async generateSiteETag(siteId, metadata) {
</span></span><span>  const components =3D [
</span><span>    metadata.publishedAt,
</span><span>    metadata.contentVersion,
</span><span>    metadata.assetVersion,
</span><span>    await this.getCMSCollectionVersions(siteId)
</span><span>  ];
</span><span> =20
</span><span>  const combined =3D components.join('|');
</span><span>  const hash =3D await this.computeHash(combined);
</span><span>  return hash.substring(0, 16);
</span><span>}
</span><span>
</span><span>// Asset-level conditional caching v=E1=BB=9Bi immutable detec=
tion
</span><span>async handleAssetRequest(assetPath, request) {
</span><span>  const isVersionedAsset =3D /\.[a-f0-9]{8,}\.(css|js|png|jpg|=
webp)$/.test(assetPath);
</span><span> =20
</span><span>  if (isVersionedAsset) {
</span><span>    // Versioned assets are immutable
</span><span>    const clientETag =3D request.headers.get('if-none-match');
</span><span>    const assetETag =3D this.extractVersionFromPath(assetPath)=
;
</span><span>   =20
</span><span>    if (clientETag &amp;&amp; clientETag.includes(assetETag)) =
{
</span><span>      return new Response(null, {
</span><span>        status: 304,
</span><span>        headers: {
</span><span>          'ETag': `"${assetETag}"`,
</span><span>          'Cache-Control': 'public, max-age=3D31536000, immuta=
ble',
</span><span>          'Expires': new Date(Date.now() + 31536000000).toUTCS=
tring()
</span><span>        }
</span><span>      });
</span><span>    }
</span><span>  }
</span><span> =20
</span><span>  // Non-versioned assets use content-based validation
</span><span>  return this.handleNonVersionedAsset(assetPath, request);
</span><span>}
</span><span>
</span><span>// CMS collection conditional caching
</span><span>async handleCMSCollectionRequest(siteId, collectionSlug, reque=
st) {
</span><span>  const collection =3D await this.getCMSCollection(siteId, col=
lectionSlug);
</span><span>  const clientETag =3D request.headers.get('if-none-match');
</span><span> =20
</span><span>  // Collection ETag based on:
</span><span>  // - Collection schema version
</span><span>  // - Last item modification time
</span><span>  // - Item count
</span><span>  const collectionETag =3D this.generateCollectionETag(collect=
ion);
</span><span> =20
</span><span>  if (clientETag =3D=3D=3D `"${collectionETag}"`) {
</span><span>    return new Response(null, {
</span><span>      status: 304,
</span><span>      headers: {
</span><span>        'ETag': `"${collectionETag}"`,
</span><span>        'Cache-Control': 'public, max-age=3D60', // 1 minute
</span><span>        'Vary': 'Accept, Accept-Encoding'
</span><span>      }
</span><span>    });
</span><span>  }
</span><span> =20
</span><span>  const collectionData =3D await this.serializeCMSCollection(c=
ollection);
</span><span> =20
</span><span>  return new Response(JSON.stringify(collectionData), {
</span><span>    status: 200,
</span><span>    headers: {
</span><span>      'ETag': `"${collectionETag}"`,
</span><span>      'Content-Type': 'application/json',
</span><span>      'Cache-Control': 'public, max-age=3D60'
</span><span>    }
</span><span>  });
</span><span>}
</span><span>
</span><span>generateCollectionETag(collection) {
</span><span>  const signature =3D [
</span><span>    collection.id,
</span><span>    collection.schema_version,
</span><span>    collection.updated_at,
</span><span>    collection.items_count,
</span><span>    collection.last_item_modified
</span><span>  ].join(':');
</span><span> =20
</span><span>  return this.quickHash(signature);
</span><span>}
</span><span>
</span><span>// Performance optimization: Batch validation
</span><span>async batchValidateMultipleResources(requests) {
</span><span>  const validations =3D await Promise.all(
</span><span>    requests.map(async req =3D&gt; {
</span><span>      const startTime =3D performance.now();
</span><span>      const isNotModified =3D await this.fastValidateResource(=
req);
</span><span>      const endTime =3D performance.now();
</span><span>     =20
</span><span>      return {
</span><span>        url: req.url,
</span><span>        isNotModified,
</span><span>        validationTime: endTime - startTime
</span><span>      };
</span><span>    })
</span><span>  );
</span><span> =20
</span><span>  // Track performance metrics
</span><span>  const averageValidationTime =3D validations.reduce((sum, v) =
=3D&gt; sum + v.validationTime, 0) / validations.length;
</span><span>  const notModifiedRate =3D validations.filter(v =3D&gt; v.isN=
otModified).length / validations.length;
</span><span> =20
</span><span>  this.trackMetrics('batch_validation', {
</span><span>    requestCount: requests.length,
</span><span>    averageValidationTime,
</span><span>    notModifiedRate
